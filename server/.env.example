# server/.env.example
# Copy this file to server/.env and fill in the values.
# Never commit .env — it contains secrets.

NODE_ENV=development
PORT=3000

# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Use the DIRECT connection string (host WITHOUT "-pooler").
# Get it from: Neon dashboard → your project → Connection Details → select "Direct"
# One URL serves both the running app and "prisma migrate".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL = postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── OTP (mock — printed in server log) ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# ─── App ──────────────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGIN=*

# ─── Receipt uploads ──────────────────────────────────────────────────────────
MAX_RECEIPT_BYTES=5242880

# ─── Cloudinary (needed from Phase B6) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
